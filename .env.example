# Copy to .env and export the variables in the shell that starts the MCP server.
# The server reads only the process environment. It does not open this file.

# Public iNotes host, no trailing slash.
INOTES_BASE_URL=https://mail.example.com

# Mail NSF path on that host.
INOTES_MAIL_PATH=/mail/MAILFILE.nsf

# Name and password from the iNotes login form (Username / Password).
# Use the same user name you type on the web login page.
INOTES_USERNAME=
INOTES_PASSWORD=

# Optional alternative to the username and password: a Cookie header from your
# own already signed-in browser session (DomAuthSessId, LtpaToken, ...).
# Do not commit a real value.
# INOTES_COOKIE=

# Name shown in the iNotes address picker ("Search in"). Empty uses the personal book.
INOTES_DIRECTORY=

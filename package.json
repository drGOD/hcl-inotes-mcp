{
  "name": "inotes-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP-сервер для почтового ящика HCL iNotes через веб-интерфейс",
  "bin": {
    "inotes-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
